# =====================================================================
# Texas Business Data Enrichment Pipeline — configuration template
# Copy to `.env` and fill in real values. Never commit `.env`.
# =====================================================================

# ----- Mode -----------------------------------------------------------
# When true, all three enrichment sources return deterministic simulated
# responses and NO real API calls/credits are consumed. Set to false for
# production runs.
MOCK_MODE=true

# ----- Paths ----------------------------------------------------------
INPUT_DIR=input_data
OUTPUT_DIR=output_data

# ----- Primary: NAICS Association BizAPI ------------------------------
# https://www.naics.com/bizapi-documents-v2/  (HTTP Basic auth)
# Rate limit: 3 requests per rolling second; billed per successful match.
BIZAPI_URL=https://naics.com/wp-json/naicsapi/v2/cosearch
BIZAPI_USERNAME=
BIZAPI_PASSWORD=
BIZAPI_RATE_LIMIT_RPS=3

# ----- Secondary: Explorium firmographics -----------------------------
# https://developers.explorium.ai  (header: api_key)
# Free tier ~500 enrichments/month; usage is tracked across runs in
# output_data/.explorium_usage.json so the cap is never exceeded.
EXPLORIUM_API_KEY=
EXPLORIUM_BASE_URL=https://api.explorium.ai/v1
EXPLORIUM_MONTHLY_LIMIT=500
EXPLORIUM_RATE_LIMIT_RPS=1

# ----- Tertiary: Apify D&B directory scraper --------------------------
# https://apify.com/memo23/dnb-scraper — employees + DUNS + industry text
# (no NAICS codes). Runs in BATCH mode after each file: records still
# missing fields are sent in chunked `queries` lists per async actor run.
# epctex~dnb-scraper is known-broken for keyword search — avoid it.
APIFY_TOKEN=
APIFY_DNB_ACTOR=memo23~dnb-scraper
APIFY_BATCH_SIZE=25            # queries per actor run
APIFY_MAX_QUERIES_PER_RUN=1000 # whole-run cap (~free-plan credit worth)
APIFY_MAX_QUERIES_PER_FILE=50  # spread coverage across cities
APIFY_RUN_TIMEOUT=900          # seconds to wait per actor run

# ----- Free backstop: OpenStreetMap Nominatim -------------------------
# No API key required. NAICS only (no employee data). OSM usage policy
# caps requests at 1/sec; results are cached to disk for re-runs.
OSM_ENABLED=true
OSM_RATE_LIMIT_RPS=1
OSM_USER_AGENT=texas-biz-enrichment/1.0 (NAICS enrichment research; contact: local)
OSM_CACHE_FILE=cache/osm_cache.json

# ----- Matching -------------------------------------------------------
# Minimum fuzzy name-similarity score (0-100) to accept an API match.
MATCH_THRESHOLD=85
# Bonus points added when the candidate's ZIP-5 matches the record's.
ZIP_MATCH_BONUS=5

# ----- HTTP behavior --------------------------------------------------
REQUEST_TIMEOUT=30
RETRY_ATTEMPTS=4

# ----- Safety knobs ---------------------------------------------------
# Hard cap on records that trigger API calls across a whole run
# (0 = unlimited). Useful to bound spend while validating real APIs.
MAX_API_CALLS_PER_RUN=0
# Process at most N records per input file (0 = all).
MAX_RECORDS_PER_FILE=0
# When a record already reports a NAICS code, still call the APIs to get
# an employee count (true) or skip the record entirely (false).
LOOKUP_EMPLOYEES_WHEN_NAICS_PRESENT=true

LOG_LEVEL=INFO

# Keyword-in-name NAICS inference (local, free, labeled "name_rule",
# confidence 70 — inferred not verified).
NAME_RULES_ENABLED=true

# SEC EDGAR local index (free; build with scripts/build_edgar_index.py)
EDGAR_ENABLED=true

# Census CBP employee estimates for rows missing real counts; fills the
# labeled Employee_Estimate column (county x NAICS average, not actuals).
EMPLOYEE_ESTIMATES_ENABLED=true

# Apify master switch — actor runs cost free-plan credits even when they
# return nothing, so keep off unless deliberately spending.
APIFY_ENABLED=false
