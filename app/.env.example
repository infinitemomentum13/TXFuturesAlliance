# TX Futures Alliance Pathways — environment
#
# VITE_USE_MOCK_API
#   "true" (default when unset): the in-browser stand-in server (MSW) answers
#   every /api/v1 request, seeded from the fictional sample_students.json.
#   "false": requests go straight to VITE_API_BASE_URL (the real back end).
VITE_USE_MOCK_API=true

# VITE_API_BASE_URL
#   Base path the typed API client (src/api/client.ts) prefixes to every call.
#   The mock server answers at this same base. For the real back end, set the
#   full URL, e.g. https://api.txfuturesalliance.org/v1
VITE_API_BASE_URL=/api/v1
